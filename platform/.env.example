# ---- Copy to .env and fill in. Never commit real secrets. ----

# Database (PostgreSQL)
DATABASE_URL="postgresql://axiom:axiom@localhost:5432/axiom?schema=public"

# Redis (cache / queue)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="http://localhost:3000"

# Web (Next.js) — public vars must be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Object storage (S3-compatible: Cloudflare R2 / AWS S3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="axiom-designs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email — Resend (verify email, password reset, magic-link sign-in)
# Without RESEND_API_KEY, links are printed to the API console instead of sent.
# EMAIL_FROM must be a verified sender/domain in Resend (or use onboarding@resend.dev to test).
EMAIL_FROM="Axiom Siam <no-reply@axiomsiam.com>"
RESEND_API_KEY=""

# Google Sign-In — https://console.cloud.google.com → Credentials → OAuth client (Web)
# Add your site URL to "Authorized JavaScript origins". Only the client ID is needed
# (server verifies the ID token via Google's tokeninfo endpoint).
GOOGLE_CLIENT_ID=""

# Payments — Thai bank transfer + slip upload (no payment gateway)
#
# These are only the FIRST-RUN defaults. Once an admin saves the account in
# /admin → ตั้งค่า → บัญชีรับเงิน, the database wins and these are ignored —
# so changing a bank account never needs a deploy.
#
# PromptPay generates the QR. Leave blank and customers just transfer to the
# account number instead.
PROMPTPAY_ID=""             # 0812345678 (phone) / 1234567890123 (nat id) / 15-digit e-wallet
PROMPTPAY_TYPE="phone"      # phone | natid | ewallet
BANK_NAME=""                # เช่น กสิกรไทย
BANK_ACCOUNT_NO=""          # xxx-x-xxxxx-x
BANK_ACCOUNT_NAME=""        # บจก. แอกซิออม สยาม
BANK_NOTE=""                # shown under the QR; blank = sensible default

# Where uploaded slips are written. Financial records — back this folder up.
UPLOAD_DIR="./uploads"
# signs the short-lived links to payment slips (slips are not public files); falls back to JWT_ACCESS_SECRET
SLIP_URL_SECRET="change-me-slips"

# Optional: printed on the invoice
COMPANY_TAX_ID=""
# Seller details printed on full tax invoices (ใบกำกับภาษีเต็มรูป). Tax ID + address are required to issue one.
COMPANY_NAME="Axiom Siam Co.,Ltd."
COMPANY_ADDRESS=""
# 00000 = สำนักงานใหญ่, otherwise the 5-digit branch number
COMPANY_BRANCH="00000"
