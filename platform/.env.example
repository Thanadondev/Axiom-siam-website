# ---- Copy to .env and fill in. Never commit real secrets. ----

# Database (PostgreSQL)
DATABASE_URL="postgresql://axiom:axiom@localhost:5432/axiom?schema=public"

# Redis (cache / queue)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="http://localhost:3000"

# Web (Next.js) — public vars must be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Object storage (S3-compatible: Cloudflare R2 / AWS S3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="axiom-designs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email (Resend or SES)
EMAIL_FROM="no-reply@axiomsiam.com"
RESEND_API_KEY=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
OMISE_PUBLIC_KEY=""
OMISE_SECRET_KEY=""

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
