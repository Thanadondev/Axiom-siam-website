{
  "name": "@axiom/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:fontkit": "esbuild ../../node_modules/fontkit/dist/browser-module.mjs --bundle --minify --format=iife --global-name=fontkit --platform=browser --target=es2019 --legal-comments=eof --outfile=public/designer/fontkit.min.js"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "fontkit": "2.0.4",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
