{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "moduleResolution": "node",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": "./"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  // `nest start --watch`: files customers upload (UPLOAD_DIR=./uploads) must not
  // count as code changes, or every logo upload restarts the API mid-order
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "uploads", "dist", "coverage"]
  }
}
